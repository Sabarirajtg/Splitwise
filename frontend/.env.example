# Backend URL used by browser requests. localhost works only on the same computer.
# For a phone test through HTTPS tunnels, use the backend tunnel URL instead.
NEXT_PUBLIC_API_URL=http://localhost:4000

# NextAuth (Google login)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical frontend URL. localhost is for same-computer development only.
# For Google sign-in from a phone, use an HTTPS frontend tunnel URL and register
# https://<frontend-tunnel-host>/api/auth/callback/google in Google Cloud Console.
NEXTAUTH_URL=http://localhost:3000

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match INTERNAL_API_SECRET on the backend exactly
INTERNAL_API_SECRET=
