NEXT_PUBLIC_API_URL=http://localhost:4000

# NextAuth (Google login)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The URL this frontend is running at (http://localhost:3000 locally, your Vercel URL in production)
NEXTAUTH_URL=http://localhost:3000

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match INTERNAL_API_SECRET on the backend exactly
INTERNAL_API_SECRET=
