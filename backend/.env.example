MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/splitshare
PORT=4000
# Shared secret between this backend and the Next.js server-side Google auth callback.
# Generate any long random string (e.g. `openssl rand -hex 32`) and use the SAME value
# in the frontend's INTERNAL_API_SECRET env var.
INTERNAL_API_SECRET=
