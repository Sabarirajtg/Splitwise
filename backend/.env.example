MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/splitshare
PORT=4000
# Shared secret between this backend and the Next.js server-side Google auth callback.
# Generate any long random string (e.g. `openssl rand -hex 32`) and use the SAME value
# in the frontend's INTERNAL_API_SECRET env var.
INTERNAL_API_SECRET=

# Optional Web Push notifications. Generate the VAPID key pair with:
#   cd backend && node scripts/generate-vapid-keys.js
# Set the same values in your backend deployment environment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI for your app, for example mailto:you@example.com
VAPID_SUBJECT=
